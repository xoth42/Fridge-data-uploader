# Dodo fridge configuration (Bluefors)
# Confirmed from diagnose.py report 2026-03-23.
# Query Prometheus: fridge_diagnostic_url{instance="fridge-dodo"}

fridge:
  name: Dodo
  instance: fridge-dodo
  type: bluefors

# Temperature channels confirmed present (CH3, CH4, CH9 absent on this fridge).
temperature_channels:
  1: "50K flange"
  2: "4K flange"
  5: "Still"
  6: "MXC"    # mK-range — value stored as raw K

resistance_channels:
  1: "50K flange"
  2: "4K flange"
  5: "Still"
  6: "MXC"

pressure_channels:
  1: "50K flange"
  2: "4K flange"
  5: "Still"
  6: "MXC"

collect:
  status:     true
  flowmeter:  true
  heaters:    true
  channels:   false   # no Channels file on this fridge
  maxigauge:  true

# Filename overrides — Dodo uses lowercase "heaters_" instead of Bluefors default "Heaters ".
file_naming:
  heaters: "heaters_{date}.log"