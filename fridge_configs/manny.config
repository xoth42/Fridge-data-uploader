# Manny fridge configuration (Bluefors)
# Used by push_metrics.py to label and filter metrics for this fridge.
# MACHINE_NAME in .env must match the instance field here.

fridge:
  name: Manny
  instance: fridge-manny
  type: bluefors

# Temperature channels present on this fridge.
# CH number -> human-readable location label (used in Grafana display_name).
# Run diagnose.py or collectall.py to discover actual CH files present.
temperature_channels:
  1:  "50K flange"
  2:  "4K flange"
  5:  "Still"
  6:  "MXC"         # mK-range — values stored as raw K
  9:  "FSE"          # mK-range — values stored as raw K

# Resistance channels (same CH numbers as temperature where applicable).
resistance_channels:
  1:  "50K flange"
  2:  "4K flange"
  5:  "Still"
  6:  "MXC"
  9:  "FSE"

# Which file types to collect. Set to false to disable a file type.
collect:
  status:     true
  flowmeter:  true
  heaters:    true
  channels:   true   # valves
  maxigauge:  true
